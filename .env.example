# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma.config.ts loads them via dotenv.

DATABASE_URL="postgresql://youflicks:youflicks@localhost:5432/youflicks?schema=public"
BETTER_AUTH_SECRET="replace-with-a-32-byte-secret"
BETTER_AUTH_URL="http://127.0.0.1:43147"
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
# Closed beta: prefer Cloudflare R2 (S3-compatible). New beta writes go to this store.
# STORAGE_DRIVER="r2"
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION="auto"
# STORAGE_S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
# STORAGE_S3_FORCE_PATH_STYLE="true"
# Temporary invite-only front door. Unset is fail-closed in production.
# Explicit false restores public free-tier signup.
BETA_INVITE_ONLY="false"
# Ops mint / spend visibility. Unset hides /api/ops/* (404).
# BETA_OPS_SECRET=""
# Path B: production invite-only defaults to none (pre-verify at invite mint).
# log is forbidden in production beta. Path A SMTP is not in this wave.
EMAIL_DRIVER="log"
AI_CONSENT_POLICY_VERSION="beta-ai-v1"
# Optional Sentry store DSN for JOB_FAILED / SPEND_GUARD / STORAGE_ERROR.
# SENTRY_DSN=""
LOG_LEVEL="info"
MEDIA_MAX_IMAGE_BYTES="41943040"
MEDIA_MAX_VIDEO_BYTES="536870912"
# Preferred analysis adapter key. Leave empty to use the first ready adapter.
ANALYSIS_PROVIDER=""
# HTTP vision adapter (disabled until URL, key, and model are set).
ANALYSIS_HTTP_PROVIDER_KEY="http.vision"
ANALYSIS_HTTP_BASE_URL=""
ANALYSIS_HTTP_API_KEY=""
ANALYSIS_HTTP_MODEL=""
ANALYSIS_HTTP_TIMEOUT_MS="45000"
# Director (Phase 2F). Production availability requires URL, key, and model.
DIRECTOR_HTTP_PROVIDER_KEY="http.director"
DIRECTOR_HTTP_BASE_URL=""
DIRECTOR_HTTP_API_KEY=""
DIRECTOR_HTTP_MODEL=""
DIRECTOR_HTTP_TIMEOUT_MS="60000"
# Explicit opt-in for local/deterministic Director in development/test only.
# Ignored in production (NODE_ENV=production) — never enables fake Director AI.
DIRECTOR_ALLOW_LOCAL="false"
# Story composer (M1). Production availability requires URL, key, and model.
STORY_HTTP_PROVIDER_KEY="http.story"
STORY_HTTP_BASE_URL=""
STORY_HTTP_API_KEY=""
STORY_HTTP_MODEL=""
STORY_HTTP_TIMEOUT_MS="60000"
# Explicit opt-in for local/deterministic story composition in development/test only.
# Ignored in production — never enables fake production story AI.
STORY_ALLOW_LOCAL="false"
# Timeline composer (M2). Production availability requires URL, key, and model.
TIMELINE_HTTP_PROVIDER_KEY="http.timeline"
TIMELINE_HTTP_BASE_URL=""
TIMELINE_HTTP_API_KEY=""
TIMELINE_HTTP_MODEL=""
TIMELINE_HTTP_TIMEOUT_MS="60000"
# Explicit opt-in for local/deterministic timeline composition in development/test only.
# Ignored in production — never enables fake production timeline AI.
TIMELINE_ALLOW_LOCAL="false"
# Asset generator (M3). Production availability requires URL, key, and model.
# Point these at the YouFlicks asset gateway (npm run gateway:asset). The app
# never needs a fal / Replicate (or other vendor) key — that stays on the gateway process.
# Alternate transport example: ASSET_HTTP_PROVIDER_KEY="replicate:wan-video/wan-2.7-i2v"
# with YF_GATEWAY_BACKEND=replicate + REPLICATE_API_TOKEN on the gateway process only.
# See docs/R1_VIDEO_HTTP_GATEWAY.md.
ASSET_HTTP_PROVIDER_KEY="http.asset"
ASSET_HTTP_BASE_URL=""
ASSET_HTTP_API_KEY=""
ASSET_HTTP_MODEL=""
# Video generation can exceed 90s. Use 300000 when pointing at a real gateway.
ASSET_HTTP_TIMEOUT_MS="300000"
# Honest R1 default: VIDEO_GENERATION only. Empty also means VIDEO_GENERATION.
# Add IMAGE_GENERATION only if the gateway covers stills. Do not list
# VOICE_SYNTHESIS, MUSIC_GENERATION, or SFX_GENERATION unless a real adapter covers them.
ASSET_HTTP_CAPABILITIES="VIDEO_GENERATION"
# Explicit opt-in for local/deterministic asset generation in development/test only.
# Ignored in production — never enables fake production asset AI.
ASSET_ALLOW_LOCAL="false"
# Renderer (M4). Production availability requires URL, key, and model.
RENDER_HTTP_PROVIDER_KEY="http.renderer"
RENDER_HTTP_BASE_URL=""
RENDER_HTTP_API_KEY=""
RENDER_HTTP_MODEL=""
RENDER_HTTP_TIMEOUT_MS="120000"
# Explicit opt-in for local/deterministic rendering in development/test only.
# Ignored in production — never enables fake production render availability.
RENDER_ALLOW_LOCAL="false"
# M8.1 email verification uses Better Auth + the log adapter (no vendor).
# Confirmation links are written to the server log outside production.
# Production invite-only beta must use EMAIL_DRIVER=none (Path B pre-verify)
# or a later real VerificationEmailPort. log is fail-closed in production beta.
# M7 share links. Leave SHARE_TOKEN_SECRET unset to reuse BETTER_AUTH_SECRET.
# SHARE_TOKEN_SECRET=""
SHARE_LINK_TTL_MS="604800000"

# Asset gateway (process env — keep vendor keys off the Next.js app).
# Live backends apply beta defaults 10 jobs / $8 when caps are unset.
# YF_GATEWAY_MAX_JOBS="10"
# YF_GATEWAY_MAX_SPEND_USD="8"
# YF_GATEWAY_WEBHOOK_SECRET=""
