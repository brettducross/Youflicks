# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma.config.ts loads them via dotenv.

DATABASE_URL="postgresql://youflicks:youflicks@localhost:5432/youflicks?schema=public"
BETTER_AUTH_SECRET="replace-with-a-32-byte-secret"
BETTER_AUTH_URL="http://127.0.0.1:43147"
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
LOG_LEVEL="info"
MEDIA_MAX_IMAGE_BYTES="41943040"
MEDIA_MAX_VIDEO_BYTES="536870912"
# Preferred analysis adapter key. Leave empty to use the first ready adapter.
ANALYSIS_PROVIDER=""
# HTTP vision adapter (disabled until URL, key, and model are set).
ANALYSIS_HTTP_PROVIDER_KEY="http.vision"
ANALYSIS_HTTP_BASE_URL=""
ANALYSIS_HTTP_API_KEY=""
ANALYSIS_HTTP_MODEL=""
ANALYSIS_HTTP_TIMEOUT_MS="45000"
# Director (Phase 2F). Production availability requires URL, key, and model.
DIRECTOR_HTTP_PROVIDER_KEY="http.director"
DIRECTOR_HTTP_BASE_URL=""
DIRECTOR_HTTP_API_KEY=""
DIRECTOR_HTTP_MODEL=""
DIRECTOR_HTTP_TIMEOUT_MS="60000"
# Explicit opt-in for local/deterministic Director in development/test only.
# Ignored in production (NODE_ENV=production) — never enables fake Director AI.
DIRECTOR_ALLOW_LOCAL="false"
