// YouFlicks domain schema — Phase 1 foundation.
//
// Status and provider fields are strings (not Prisma enums) so later
// pipeline stages and vendors can be added without a breaking enum migration.
// JSON columns hold YouFlicks-owned payloads. Provider identity is a
// string key (provenance), never a vendor enum.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth). Field names follow the adapter's expected schema.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  projects                 Project[]
  tasteProfile             TasteProfile?
  sponsorshipPreference    UserSponsorshipPreference?
  sponsors                 Sponsor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Filmmaking pipeline
// User → Project → Media Assets → Media Analysis → AI Director → CreativePlan
//      → Story Structure → Timeline → Rendering → Finished Movie → Publishing
// ---------------------------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  logline     String?
  /// DRAFT | INGESTING | ANALYZING | DIRECTING | EDITING | RENDERING | COMPLETED | ARCHIVED
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets           MediaAsset[]
  creativePlans    CreativePlan[]
  storyStructures  StoryStructure[]
  timelines        Timeline[]
  renderJobs       RenderJob[]
  movies           FinishedMovie[]
  jobs             Job[]
  creativeIntent   ProjectCreativeIntent?
  attributions     ProviderAttribution[]
  credits          FilmCredits[]
  sponsorPlacements SponsorPlacement[]

  @@index([ownerId, updatedAt])
  @@map("project")
}

/// Phase 2F — YouFlicks-owned Director output. Meaning-level only.
/// Not StoryStructure. Not a timeline. Not a render. Versions are preserved.
model CreativePlan {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version          Int
  /// DRAFT | READY | SUPERSEDED | FAILED
  status           String   @default("DRAFT")
  /// Validated YouFlicks-owned CreativePlan JSON (schemaVersion "1.0").
  plan             Json
  jobId            String?
  /// SHA-256 of assembled DirectorInput. Raw input is not stored.
  inputFingerprint String
  /// Adapter key — provenance only, never a vendor enum.
  providerKey      String
  /// Capability the Director used (e.g. STORY_REASONING).
  capability       String
  modelId          String?
  modelVersion     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@index([jobId])
  @@map("creative_plan")
}

model MediaAsset {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// PHOTO | VIDEO | AUDIO | OTHER
  kind        String
  /// Original filename as uploaded by the user.
  filename    String
  mimeType    String
  byteSize    BigInt
  /// Opaque key understood by StoragePort. Never a vendor URL.
  storageKey  String
  /// Optional preview/thumbnail key on the same StoragePort.
  previewKey  String?
  durationMs  Int?
  width       Int?
  height      Int?
  /// UPLOADING | READY | FAILED | ARCHIVED
  status      String   @default("UPLOADING")
  /// NOT_ANALYZED | QUEUED | PROCESSING | COMPLETED | FAILED
  analysisStatus String @default("NOT_ANALYZED")
  checksum    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses MediaAnalysis[]
  clips    TimelineClip[]

  @@index([projectId, createdAt])
  @@map("media_asset")
}

model MediaAnalysis {
  id           String     @id @default(cuid())
  assetId      String
  asset        MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Adapter key — provenance only, never a vendor enum.
  providerKey  String
  /// Generic model identifier (provenance). Not a vendor column.
  modelId      String?
  /// Generic model version (provenance).
  modelVersion String?
  /// YouFlicks-owned analysis document version, e.g. "1.0"
  schemaVersion String    @default("1.0")
  /// QUEUED | PROCESSING | COMPLETED | FAILED
  status       String     @default("QUEUED")
  /// Normalized YouFlicks analysis document. Never raw vendor JSON.
  payload      Json?
  error        String?
  analyzedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assetId, createdAt])
  @@map("media_analysis")
}

/// M1 — YouFlicks-owned narrative StoryDocument. Not a timeline. Not a render.
/// Each version derives from exactly one READY CreativePlan version.
/// Versions are preserved. In-progress belongs on Job, not on this row.
model StoryStructure {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version             Int
  /// DRAFT | READY | SUPERSEDED | FAILED — never PENDING/RUNNING.
  status              String   @default("DRAFT")
  /// Validated YouFlicks-owned StoryDocument JSON (schemaVersion "1.0").
  payload             Json?
  jobId               String?
  /// SHA-256 of assembled StoryComposerInput. Raw input is not stored.
  inputFingerprint    String
  /// Provenance: exactly one READY CreativePlan version.
  creativePlanId      String
  creativePlanVersion Int
  planFingerprint     String?
  /// Adapter key — provenance only, never a vendor enum.
  providerKey         String
  /// Capability the story composer used (e.g. STORY_COMPOSITION).
  capability          String
  modelId             String?
  modelVersion        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  timelines Timeline[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@index([jobId])
  @@map("story_structure")
}

/// M2 — YouFlicks-owned executable TimelineDocument. Not a StoryStructure.
/// Each version derives from exactly one READY StoryStructure version.
/// Versions are preserved. In-progress belongs on Job, not on this row.
model Timeline {
  id                    String         @id @default(cuid())
  projectId             String
  project               Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version               Int
  /// DRAFT | READY | SUPERSEDED | FAILED — never PENDING/RUNNING.
  status                String         @default("DRAFT")
  /// Validated YouFlicks-owned TimelineDocument JSON (schemaVersion "1.0").
  payload               Json?
  jobId                 String?
  /// SHA-256 of assembled TimelineComposerInput. Raw input is not stored.
  inputFingerprint      String
  /// Provenance: exactly one READY StoryStructure version.
  storyStructureId      String
  storyStructure        StoryStructure @relation(fields: [storyStructureId], references: [id], onDelete: Restrict)
  storyStructureVersion Int
  storyFingerprint      String?
  /// Convenience copies from StoryStructure provenance — not a second source of truth.
  creativePlanId        String?
  creativePlanVersion   Int?
  /// Adapter key — provenance only, never a vendor enum.
  providerKey           String
  /// Capability the timeline composer used (e.g. TIMELINE_COMPOSITION).
  capability            String
  modelId               String?
  modelVersion          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  clips      TimelineClip[]
  renderJobs RenderJob[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@index([jobId])
  @@map("timeline")
}

model TimelineClip {
  id         String     @id @default(cuid())
  timelineId String
  timeline   Timeline   @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  /// Required MediaAsset id for every placed clip. Unmet roles are not clip rows.
  assetId    String
  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  sortOrder  Int
  /// Absolute range on the timeline (projection of timelineStartMs / timelineEndMs).
  startMs    Int
  endMs      Int
  /// YouFlicks-owned clip extras: trackKey, source in/out, transition, caption, notes.
  payload    Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([timelineId, sortOrder])
  @@map("timeline_clip")
}

model RenderJob {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timelineId   String?
  timeline     Timeline? @relation(fields: [timelineId], references: [id], onDelete: SetNull)
  /// Adapter key for the renderer implementation.
  providerKey  String?
  /// QUEUED | RUNNING | SUCCEEDED | FAILED | CANCELLED
  status       String    @default("QUEUED")
  outputKey    String?
  error        String?
  payload      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  movies FinishedMovie[]

  @@index([projectId, createdAt])
  @@map("render_job")
}

model FinishedMovie {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  renderJobId String?
  renderJob   RenderJob? @relation(fields: [renderJobId], references: [id], onDelete: SetNull)
  title       String
  durationMs  Int?
  storageKey  String?
  /// PROCESSING | READY | FAILED
  status      String     @default("PROCESSING")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  publications Publication[]
  credits      FilmCredits[]
  placements   SponsorPlacement[]

  @@index([projectId, createdAt])
  @@map("finished_movie")
}

model Publication {
  id              String        @id @default(cuid())
  movieId         String
  movie           FinishedMovie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  /// Destination adapter key (youtube, download, …) — not an enum.
  destinationKey  String
  /// PENDING | PUBLISHED | FAILED
  status          String        @default("PENDING")
  externalId      String?
  payload         Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([movieId, createdAt])
  @@map("publication")
}

/// Generic background work. Application services enqueue through JobQueuePort.
model Job {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// MEDIA_ANALYZE | AI_DIRECT | AI_STORY | AI_TIMELINE | RENDER | PUBLISH | …
  type        String
  /// PENDING | RUNNING | SUCCEEDED | FAILED | CANCELLED
  status      String    @default("PENDING")
  payload     Json?
  result      Json?
  error       String?
  attempts    Int       @default(0)
  runAfter    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([projectId, createdAt])
  @@map("job")
}

// ---------------------------------------------------------------------------
// Phase 2D — Taste, intent, attribution, credits, sponsorship foundation
// String keys only. No vendor enums. Sponsors never own creative fields.
// ---------------------------------------------------------------------------

/// Subscriber taste container. One per user. Not sent to providers or sponsors.
model TasteProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences TastePreference[]
  signals     TasteSignal[]

  @@map("taste_profile")
}

/// Explicit subscriber preference. Dimension keys are open strings.
model TastePreference {
  id        String       @id @default(cuid())
  profileId String
  profile   TasteProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// e.g. favorite_films, genres, pacing, visual_style — not an enum.
  dimension String
  value     String
  /// EXPLICIT only. Inferred observations live on TasteSignal.
  source    String       @default("EXPLICIT")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([profileId, dimension])
  @@map("taste_preference")
}

/// Timestamped observation. origin is EXPLICIT or INFERRED.
model TasteSignal {
  id         String       @id @default(cuid())
  profileId  String
  profile    TasteProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// USER_SELECTED_MOVIE | USER_SELECTED_STYLE | USER_RATED_FILM | …
  kind       String
  /// EXPLICIT | INFERRED
  origin     String
  payload    Json?
  recordedAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  @@index([profileId, recordedAt])
  @@index([profileId, kind])
  @@map("taste_signal")
}

/// Defaults are off. The subscriber must opt in to any sponsorship presentation.
model UserSponsorshipPreference {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowSponsorCredits          Boolean  @default(false)
  allowSponsoredEndCard        Boolean  @default(false)
  allowVideoAds                Boolean  @default(false)
  allowPersonalizedSponsoring  Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("user_sponsorship_preference")
}

/// Per-project creative brief. Overrides TasteProfile for this film only.
model ProjectCreativeIntent {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purpose               String?
  audience              String?
  mood                  String?
  desiredDurationMs     Int?
  narrativeStyle        String?
  visualStyle           String?
  musicStyle            String?
  explicitInstructions  String?
  extras                Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("project_creative_intent")
}

/// Provenance for a capability adapter invocation. Not vendor JSON.
model ProviderAttribution {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId      String?
  analysisId   String?
  jobId        String?
  providerKey  String
  capability   String
  modelId      String?
  modelVersion String?
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([projectId, recordedAt])
  @@index([assetId])
  @@map("provider_attribution")
}

model FilmCredits {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  movieId   String?
  movie     FinishedMovie? @relation(fields: [movieId], references: [id], onDelete: SetNull)
  /// DRAFT | READY
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines FilmCreditLine[]

  @@index([projectId, createdAt])
  @@map("film_credits")
}

model FilmCreditLine {
  id           String      @id @default(cuid())
  creditsId    String
  credits      FilmCredits @relation(fields: [creditsId], references: [id], onDelete: Cascade)
  displayName  String
  providerKey  String?
  /// YOUFLICKS | ANALYSIS_PROVIDER | TRANSCRIPTION_PROVIDER | MUSIC_PROVIDER | VOICE_PROVIDER | RENDER_PROVIDER | SPONSOR | CAMPAIGN
  creditType   String
  displayOrder Int
  logoKey      String?
  audioKey     String?
  videoKey     String?
  linkUrl      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([creditsId, displayOrder])
  @@map("film_credit_line")
}

model Sponsor {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns SponsorCampaign[]

  @@index([ownerId])
  @@map("sponsor")
}

model SponsorCampaign {
  id        String   @id @default(cuid())
  sponsorId String
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  name      String
  /// DRAFT | ACTIVE | PAUSED | ARCHIVED
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers SponsorOffer[]

  @@index([sponsorId])
  @@map("sponsor_campaign")
}

model SponsorOffer {
  id            String          @id @default(cuid())
  campaignId    String
  campaign      SponsorCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// CREDIT_ONLY | LOGO | FEATURED_LOGO | ANIMATED_CREDIT | SPONSORED_END_CARD | AUDIO_MESSAGE | VIDEO_ADVERTISEMENT
  placementKind String
  displayName   String
  logoKey       String?
  audioKey      String?
  videoKey      String?
  linkUrl       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  placements SponsorPlacement[]

  @@index([campaignId])
  @@map("sponsor_offer")
}

/// Approved post-film presentation only. Never a creative input.
model SponsorPlacement {
  id        String       @id @default(cuid())
  offerId   String
  offer     SponsorOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  movieId   String?
  movie     FinishedMovie? @relation(fields: [movieId], references: [id], onDelete: SetNull)
  /// ELIGIBLE | APPROVED | DECLINED | APPLIED
  status    String       @default("ELIGIBLE")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([projectId])
  @@map("sponsor_placement")
}
